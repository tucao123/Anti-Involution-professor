# 凭据文件：绝不入库
.env
*.env
key.env
!.env.example

# 本机凭据路径指针（只含路径、不含密钥，环境相关，不入库）
.zhiyin_key_path

# Python
__pycache__/
*.pyc

# 本地校验 / 预览临时产物
.pv_*
.chk_*
.probe*

# 运行时产生的聚合快照与隐私数据（不含原始 JD / 不含密钥）
.market_snapshots.jsonl
.privacy/
.rag/
.stores/

# 测试产物与缓存
tests/out/
tests/.cache/
*.log
.pytest_cache/

# Next.js 控制台（依赖与构建产物不入库；public/legacy 是源码副本，需入库）
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo
web/next-env.d.ts

# 工作区助手数据与工作日志（保留在本地，不入库）
.workbuddy/
