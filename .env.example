# 职引者 ZHIYIN · 配置模板（仅占位符，不含任何真实凭据）
#
# 用法三选一：
#   A. 把已有的 key.env 路径通过环境变量告诉服务端：
#      set ZHIYIN_ENV_FILE=C:\路径\到\key.env       (Windows CMD)
#      $env:ZHIYIN_ENV_FILE="C:\路径\到\key.env"    (PowerShell)
#   B. 复制本文件为 .env 后填写（.env 已被 .gitignore 排除，绝不入库）
#   C. 用项目根的 .zhiyin_key_path 只存一行外部文件路径（不含密钥）
#
# 优先级：进程环境变量 > --env-file / ZHIYIN_ENV_FILE > .env > .zhiyin_key_path 指向的文件
# 安全：只加载本项目需要的键；key.env 中其他 provider 的行一律跳过、不载入内存。
#      笔记式文件（标签行 + 下一行才是值）同样支持，例如 qwen: / qdrant： / Cluster Endpoint：
# 密钥仅在服务端进程内存，绝不写入项目文件、不打印、不下发浏览器。

# ============================================================
# 语言模型（默认 qwen / 通义千问，OpenAI 兼容端点）
# ============================================================
# 若没有 DashScope 官方 API Key，就把下面留空；服务会自动走离线规则引擎，
# 全部 7 个视图照常可用。填好 key 后还需把 LLM_ENABLED 改为 true 才会外发。
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=30
# 服务端兜底 LLM（可选）：正式部署建议留空，由登录用户在「个人中心」自带 API 配置。
# 默认关闭：key 形态未核实前不主动外发；且 C 级用户自带数据永远不进云端模型。
LLM_ENABLED=false

# ============================================================
# 本地视觉模型（Ollama / Qwen3-VL-4B-Instruct）——简历截图/PDF/DOCX 解析
# ============================================================
# 职责：只在本机识别简历/截图里的岗位字段（岗位、学历、技能、项目等），
#       图片与原文不出本机；解析字段再经 RAG 检索后交给云端专家模型生成洞察。
# 前置：本机安装 Ollama 并拉取 instruct 版：ollama pull qwen3-vl:4b-instruct
#       （必须用 instruct 版；qwen3-vl:4b 思考版无法关闭思考、已弃用）
# 下面均为可选默认值，留空/不配即走这些默认值，通常无需修改。
LOCAL_VLM_BASE_URL=http://127.0.0.1:11434
LOCAL_VLM_API_STYLE=ollama
LOCAL_VLM_MODEL=qwen3-vl:4b-instruct
LOCAL_VLM_TIMEOUT=120
LOCAL_VLM_MAX_TOKENS=4096
# 模型目录仅用于 /api/local-vlm/status 展示，留空则优先 OLLAMA_MODELS 环境变量，
# 再回退 Ollama 默认目录；不要填含个人用户名的绝对路径。
# LOCAL_VLM_MODELS_DIR=

# ============================================================
# 向量库（Qdrant Cloud）——只放 D 级公开岗位样本 / 脱敏技能标签
# ============================================================
# 当前环境已从外部 key.env 读到 endpoint 与 api key；如需覆盖在此填写。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=zhiyin_public_d_bge
QDRANT_TIMEOUT=8
# 云端写入默认关闭。实例连通与否不影响只读探测 /api/vector/probe。
# 打开前须取得法务书面结论（见 合规与授权沟通稿.md Q18：公开岗位文本及
# 派生向量出境的评估 / 告知 / 备案，以及来源方条款是否允许存储），
# 并确认集合内容不含任何个人信息。进程环境变量或 .env 设为 true 即生效。
QDRANT_ALLOW_WRITE=false

# ============================================================
# Embedding：本地 BGE（固定，不依赖云端模型）
# 集合 zhiyin_public_d_bge 为 BGE 512 维；embedding 为服务器固定能力，
# 不向用户开放选择，也不再调用云端 embedding-v3（旧集合 zhiyin_public_d 保留只读）。
# ============================================================
EMBED_BACKEND=bge
BGE_MODEL=BAAI/bge-small-zh-v1.5
BGE_DIM=512
# 权重随镜像预置时自动加载；离线冒烟测试可改 false（降级为本地 hash 投影）
BGE_AUTOLOAD=true
EMBED_DIM=512

# ============================================================
# 三库（未启动服务时自动降级：SQLite / 内存 TTL / 本地邻接表）
# ============================================================
# 本机 PostgreSQL 18 已接线：库 zhiyin / 角色 zhiyin / 端口 5432，
# 密码从外部 key.env 读取，本模板永远留空。安装 psycopg[binary] 后
# stores/relational.py 会自动优先连 PostgreSQL，否则降级 SQLite。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zhiyin
POSTGRES_USER=zhiyin
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=disable
REDIS_URL=redis://127.0.0.1:6379/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ============================================================
# Celery 异步任务（无 Redis / 无 celery 时自动走本地 eager 执行器）
# ============================================================
CELERY_TASK_ALWAYS_EAGER=false
CELERY_CONCURRENCY=2

# ============================================================
# 合规开关（默认收窄，改动前请阅读 合规与授权沟通稿.md）
# ============================================================
# C 级用户自带数据（JD / 简历 / 截图 OCR）绝不离开本机。
ALLOW_CLOUD_FOR_USER_DATA=false
# D 级公开岗位样本无 PII，允许进入云向量库用于 skill_reference 模式。
ALLOW_PUBLIC_SAMPLE_TO_CLOUD=true
METRICS_ENABLED=true
SLO_WINDOW_DAYS=30

# ============================================================
# 认证 / 分角色（账号密码 + 微信/GitHub 快捷登录 + 管理员独立密码）—— 研究学习原型
# ============================================================
# 鉴权强度：off=不校验 / optional=有令牌才校验角色、无令牌放行(本地回归默认)
#           required=所有受保护写端点必须带有效令牌且角色匹配（正式部署用）
AUTH_MODE=optional
AUTH_SESSION_TTL=86400
# 页面级强制登录：未登录访问工作台 / 首页自动 302 到登录页（登录完才能操作）
AUTH_REQUIRE_LOGIN=true
# 会话 cookie 传输属性：本地 http 保持 false；正式 https 部署（反代终止 TLS）设为 true
AUTH_COOKIE_SECURE=false
# 会话 cookie SameSite：lax（默认）/ strict / none；none 须同时 secure=true
AUTH_COOKIE_SAMESITE=lax
# 本地账号注册 / 密码登录 / 改密（用户名或邮箱 + 密码，恒为 personal 角色）
AUTH_LOCAL_ACCOUNTS=true
# 未配置真实第三方凭据时开放「演示授权」，页面明确标注非真实登录
AUTH_DEMO_ENABLED=true
# 微信开放平台网站应用（扫码登录需要已备案的公网回调域名；本地 127.0.0.1 无法真扫）
# 三项齐全且 redirect 为 https 时自动切换为真实 OAuth，否则降级演示模式
# WECHAT_APPID=
# WECHAT_APPSECRET=
# WECHAT_REDIRECT_URI=https://your.domain/api/auth/wechat/callback
# GitHub OAuth App（Authorization callback URL 填下方 redirect，须为 https）
# 三项齐全且 redirect 为 https 时自动切换为真实授权码登录，否则降级演示模式
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
# GITHUB_REDIRECT_URI=https://your.domain/api/auth/github/callback
# 会话签名密钥 / 账号加密密钥（强烈建议配置；不配则每次启动随机，重启后登录失效、账号不可读）
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# 一旦配置不可更改，否则已注册账号永久无法解密。docker compose 部署时必填。
# AUTH_SECRET=
# PII 保险库字段加密密钥（32 字节 hex，或任意口令自动派生）
# 不配则进程内随机，重启后 .privacy 中旧密文无法解密；与 AUTH_SECRET 一样需固定。
# 生成：python -c "import secrets;print(secrets.token_hex(32))"
# ZHIYIN_PII_KEY=
# 管理员密码哈希（仅管理员密码登录入口使用，前端不存明文），生成方式：
#   python -c "import auth;print(auth.make_admin_hash('你的强密码'))"
# 不配则使用本机演示密码（仅 127.0.0.1/::1 可用，页面明确标注演示凭据）
# ADMIN_PASSWORD_HASH=

# ---- 可选：兼容旧版 deepseek（本版默认 provider 已是 qwen，通常无需填写）----
# DEEPSEEK_API_KEY=
