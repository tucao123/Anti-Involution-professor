# 职引者 ZHIYIN · 配置模板（仅占位符，不含任何真实凭据）
#
# 用法二选一：
#   A. 把已有的 key.env 路径通过环境变量告诉服务端：
#      set ZHIYIN_ENV_FILE=C:\路径\到\key.env       (Windows CMD)
#      $env:ZHIYIN_ENV_FILE="C:\路径\到\key.env"    (PowerShell)
#   B. 复制本文件为 .env，填入 DeepSeek 的 Key（.env 已被 .gitignore 排除）
#
# 服务端只识别下列 deepseek 项，配置文件中其他 provider 的内容一律跳过。

deepseek:<YOUR_DEEPSEEK_API_KEY>

# 可选覆盖（默认值已可用，通常无需填写）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
